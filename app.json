{
  "expo": {
    "name": "Erya Gold",
    "slug": "jwellery-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/eryaGold-logo1.png",
    "scheme": "eryagold",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a1f18",
        "foregroundImage": "./assets/eryaGold-logo1.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sahil011.jwelleryapp",
      "versionCode": 2
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a1f18",
          "dark": {
            "backgroundColor": "#0a1f18"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8744b5e6-4f34-443e-9311-2f4a6f64edfb"
      }
    }
  }
}
